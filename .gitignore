# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# Jest (cache dir lands in the repo root in this environment instead of the
# OS tmpdir; ignore it rather than rely on where it happens to be written)
jest_dx/
coverage/

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# project scratch space (not part of the app)
.superpowers/

# design/planning notes kept locally, not part of the repo
docs/superpowers/
